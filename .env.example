# Copia este archivo a .env y ajusta los valores.
# Nunca subas .env al repositorio.

# --- MongoDB ---
# Atlas (nube):
MONGODB_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/gestor_gastos
# MongoDB local:
# MONGODB_URI=mongodb://127.0.0.1:27017/gestor_gastos

MONGODB_DB=gestor_gastos
MONGODB_USERS_COLLECTION=users
MONGODB_EXPENSES_COLLECTION=expenses

# --- Sesión ---
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=reemplaza-con-openssl-rand-hex-32
SESSION_DAYS=30

# --- Registro ---
# Código que compartes solo con las personas que van a usar la app.
# Si lo dejas vacío, el registro queda cerrado.
REGISTRATION_CODE=cambia-este-codigo
MAX_USERS=4

# --- Modo demo (solo para el despliegue de demostración) ---
# 1 = las cuentas nuevas caducan, reciben gastos de ejemplo y rotan al llenarse.
DEMO_MODE=0
DEMO_USER_TTL_HOURS=24

# --- Límite de intentos en login y registro ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_ATTEMPTS=10

# --- Interfaz ---
CURRENCY=COP
HOST=127.0.0.1
PORT=3000

# En Render, PORT lo define la plataforma. Usa HOST=0.0.0.0 y COOKIE_SECURE=1.
# COOKIE_SECURE=1
